# Build output
build/
tools/imgproc/imgproc
tools/art-fetcher/art-fetcher

# imgproc previews: the dithered result written next to each source image
*.preview.png

# Source artwork. The packed frames in artwork/processed/ are committed - the
# device fetches those over raw.githubusercontent.com - but the originals are
# large and are not needed to build or run anything.
artwork/*.jpg
artwork/*.jpeg
artwork/*.JPG
artwork/*.png

